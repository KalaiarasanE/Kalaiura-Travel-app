# ==============================================================================
# AERORA — Travel Beyond the Map
# Environment Variables Configuration
# ==============================================================================
# Copy this file to `.env` and provide your API keys.
# AERORA includes intelligent graceful fallbacks with pre-calibrated climate
# and travel intelligence engines, so the application functions flawlessly
# even without external API keys.

# OpenWeatherMap API Key (Free tier available at https://openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=

# Google Gemini API Key (Get from Google AI Studio at https://aistudio.google.com/)
VITE_GEMINI_API_KEY=

# Unsplash Access Key (Optional for dynamic image searches: https://unsplash.com/developers)
VITE_UNSPLASH_ACCESS_KEY=
